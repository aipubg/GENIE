<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The client is self-contained, so anything referencing it must be too. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>Genie.Desktop.Tests</AssemblyName>
    <RootNamespace>Genie.Desktop.Tests</RootNamespace>
    <!-- No extra NuGet packages: this harness runs as a plain executable so the
         client tests never depend on a test runner being installed. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Genie.Desktop\Genie.Desktop.csproj" />
  </ItemGroup>

</Project>
