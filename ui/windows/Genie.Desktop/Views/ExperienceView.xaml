<UserControl x:Class="Genie.Desktop.Views.ExperienceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="Experience" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{StaticResource G.TextMid}"
                       Text="What GENIE has actually learned from past runs — what worked, what failed, and what the verifier said. Every number counts real recorded outcomes."/>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{StaticResource G.TextMid}"/>

            <!-- Filters. Each maps to a real backend field; nothing is inferred. -->
            <TextBlock Text="Filter" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mission" VerticalAlignment="Center" Margin="0,0,12,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                         Text="{Binding MissionId, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Capability" VerticalAlignment="Center" Margin="0,0,12,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                         Text="{Binding Capability, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Agent" VerticalAlignment="Center" Margin="0,0,12,6"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                         Text="{Binding Agent, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Provider" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Padding="16,8" Content="Apply filters" Command="{Binding RefreshCommand}"/>
                <Button Padding="16,8" Margin="8,0,0,0" Content="Clear" Command="{Binding ClearFiltersCommand}"/>
            </StackPanel>

            <!-- Each section is shown only when it has content: a heading with
                 nothing under it reads as a broken page. -->
            <TextBlock Text="Strategies that worked" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,4"
                       Visibility="{Binding HasSuccessful, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding Successful}"
                          Visibility="{Binding HasSuccessful, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Label, Mode=OneWay}"/>
                            <Run Text="  ("/>
                            <Run Text="{Binding Support, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Approaches that failed" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,4"
                       Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding Failed}"
                          Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Label, Mode=OneWay}"/>
                            <Run Text="  ("/>
                            <Run Text="{Binding Support, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="What the verifier said" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,4"
                       Visibility="{Binding HasVerifierLessons, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding VerifierLessons}"
                          Visibility="{Binding HasVerifierLessons, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Label, Mode=OneWay}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Support, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{StaticResource G.TextMid}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Learning by agent profile" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,4"
                       Visibility="{Binding HasAgents, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding Agents}"
                          Visibility="{Binding HasAgents, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Label, Mode=OneWay}"/>
                            <Run Text="  ("/>
                            <Run Text="{Binding Support, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Reusable provider configuration" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,4"
                       Visibility="{Binding HasConfig, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding Config}"
                          Visibility="{Binding HasConfig, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Label, Mode=OneWay}"/>
                            <Run Text="  ("/>
                            <Run Text="{Binding Support, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
