<UserControl x:Class="Genie.Desktop.Views.MissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Genie.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MissionsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Missions" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource G.Text}"/>
                <TextBlock Text="Durable work GENIE is running for you. Start one by talking to GENIE."
                           Foreground="{StaticResource G.TextMid}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,7"
                    Style="{StaticResource G.Button}"
                    Content="New Mission" Command="{Binding OpenNewMissionCommand}"
                    VerticalAlignment="Center"/>
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,7"
                    Style="{StaticResource G.Button}" Content="Refresh"
                    Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Padding="14,6" Content="Active"
                    Command="{Binding SetFilterCommand}" CommandParameter="active">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource G.Button}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActiveTab}" Value="True">
                                <Setter Property="Background" Value="{StaticResource G.Primary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Margin="8,0,0,0" Padding="14,6" Content="Scheduled"
                    Command="{Binding SetFilterCommand}" CommandParameter="scheduled">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource G.Button}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScheduledTab}" Value="True">
                                <Setter Property="Background" Value="{StaticResource G.Primary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Margin="8,0,0,0" Padding="14,6" Content="Waiting"
                    Command="{Binding SetFilterCommand}" CommandParameter="waiting">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource G.Button}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWaitingTab}" Value="True">
                                <Setter Property="Background" Value="{StaticResource G.Primary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Margin="8,0,0,0" Padding="14,6" Content="Needs attention"
                    Command="{Binding SetFilterCommand}" CommandParameter="attention">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource G.Button}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAttentionTab}" Value="True">
                                <Setter Property="Background" Value="{StaticResource G.Primary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Margin="8,0,0,0" Padding="14,6" Content="History"
                    Command="{Binding SetFilterCommand}" CommandParameter="history">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource G.Button}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHistoryTab}" Value="True">
                                <Setter Property="Background" Value="{StaticResource G.Primary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Guided manual creation (fallback), collapsed by default. -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="6"
                Background="{StaticResource G.Surface}"
                BorderBrush="{StaticResource G.LineSoft}" BorderThickness="1"
                Visibility="{Binding NewMissionOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource G.Text}"
                           Text="New Mission"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource G.TextMid}"
                           Text="Describe the ongoing work you want GENIE to keep doing — for example, &quot;every morning check these websites and email me a report&quot;."/>
                <TextBox Margin="0,10,0,0" Padding="10,8" AcceptsReturn="True"
                         Height="64" TextWrapping="Wrap"
                         Background="{StaticResource G.BgDeep}"
                         Foreground="{StaticResource G.Text}"
                         BorderBrush="{StaticResource G.Line}"
                         Text="{Binding NewMissionGoal, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Padding="12,6" Style="{StaticResource G.ButtonSmall}"
                            Content="Cancel" Command="{Binding CancelNewMissionCommand}"/>
                    <Button Margin="8,0,0,0" Padding="14,6"
                            Style="{StaticResource G.ButtonPrimary}"
                            Content="Create Mission" Command="{Binding CreateCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Dashboard -->
        <DataGrid Grid.Row="3" Margin="0,16,0,0" ItemsSource="{Binding FilteredMissions}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Objective" Binding="{Binding Goal}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="110"/>
                <DataGridTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="80"/>
                <DataGridTextColumn Header="Current" Binding="{Binding CurrentText}" Width="200"/>
                <DataGridTextColumn Header="Next" Binding="{Binding NextRunText}" Width="150"/>
                <DataGridTemplateColumn Header="" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Delete mission (cancel active work first)"
                                        Width="30" Margin="0,0,6,0" Padding="4,2"
                                        IsEnabled="{Binding IsHistory}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Pause" Padding="8,2" Margin="0,0,6,0"
                                        Command="{Binding DataContext.PauseCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsActive,
                                                     Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="Resume" Padding="8,2" Margin="0,0,6,0"
                                        Command="{Binding DataContext.ResumeCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsWaiting,
                                                     Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="Cancel" Padding="8,2"
                                        Command="{Binding DataContext.CancelCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanCancel,
                                                     Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Detail: the plan, human-readable. Never raw internal JSON. -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="14" CornerRadius="6"
                Background="{StaticResource G.Surface}"
                BorderBrush="{StaticResource G.LineSoft}" BorderThickness="1"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DetailTitle}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{StaticResource G.Text}"/>
                        <TextBlock Text="{Binding DetailMeta}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{StaticResource G.TextMid}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Padding="10,5" Content="Close"
                            Style="{StaticResource G.ButtonSmall}"
                            Command="{Binding CloseDetailCommand}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding PlanRows}" Margin="0,10,0,0" MaxHeight="220">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StatusLabel}"
                                           FontSize="12"
                                           Foreground="{StaticResource G.TextMid}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Objective}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource G.Text}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Role}"
                                           FontSize="12" Margin="10,0,0,0"
                                           Foreground="{StaticResource G.TextDim}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5" Margin="0,8,0,0" Text="{Binding Message}"
                   Foreground="{StaticResource G.TextMid}"/>
    </Grid>
</UserControl>
