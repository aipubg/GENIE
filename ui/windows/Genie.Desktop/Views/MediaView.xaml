<UserControl x:Class="Genie.Desktop.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Genie.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MediaViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + filter + refresh -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Media"
                       Style="{StaticResource G.PageTitle}"/>
            <TextBox Grid.Column="1" Margin="0,0,10,0"
                     Padding="8,6"
                     Background="{StaticResource G.BgDeep}"
                     Foreground="{StaticResource G.Text}"
                     BorderBrush="{StaticResource G.Line}"
                     Text="{Binding FilterMission, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter by mission id (optional)"/>
            <Button Grid.Column="2" Padding="14,7" Style="{StaticResource G.Button}"
                    Content="Refresh" Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- Status banner -->
        <Border Grid.Row="1" Margin="0,12,0,16" Padding="14,10" CornerRadius="6"
                Background="{StaticResource G.Surface}"
                BorderBrush="{StaticResource G.LineSoft}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource G.Cyan}"/>
                <TextBlock Text="{Binding State}" TextWrapping="Wrap"
                           Foreground="{StaticResource G.Text}"/>
            </StackPanel>
        </Border>

        <!-- Empty state: shown when no artifacts. -->
        <Border Grid.Row="2"
                Background="{StaticResource G.Surface}"
                BorderBrush="{StaticResource G.LineSoft}" BorderThickness="1"
                CornerRadius="6"
                Padding="34"
                Visibility="{Binding HasNoArtifacts,
                             Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="480">
                <TextBlock HorizontalAlignment="Center" FontSize="16"
                           FontWeight="SemiBold" Foreground="{StaticResource G.Text}"
                           Text="No generated artifacts yet."/>
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource G.TextMid}"
                           Text="Artifacts (reports, images, exports) appear here when GENIE produces them. Nothing is faked — what you see is what was actually saved."/>
            </StackPanel>
        </Border>

        <!-- Artifact browser -->
        <ItemsControl Grid.Row="2"
                      Visibility="{Binding HasArtifacts,
                                   Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4" Padding="14" CornerRadius="6"
                            Background="{StaticResource G.Surface}"
                            BorderBrush="{StaticResource G.LineSoft}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource G.Text}"
                                           FontSize="15"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Kind}"
                                               Foreground="{StaticResource G.Cyan}"
                                               FontSize="11" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Mission}"
                                               Foreground="{StaticResource G.TextMid}"
                                               FontSize="11" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Agent}"
                                               Foreground="{StaticResource G.TextMid}"
                                               FontSize="11" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding Timestamp}"
                                               Foreground="{StaticResource G.TextDim}"
                                               FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Availability}"
                                           Foreground="{StaticResource G.TextDim}"
                                           FontSize="11" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Padding="14,6"
                                    Style="{StaticResource G.ButtonPrimary}"
                                    VerticalAlignment="Center"
                                    Content="Open"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>