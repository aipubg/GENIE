<UserControl x:Class="Genie.Desktop.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Genie.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Dark workspace. The message surface, every bubble and the composer are
         explicitly themed: an unthemed ListBox paints the default light system
         surface, which was the giant white panel this page used to show. -->
    <UserControl.Resources>
        <Style x:Key="BubbleBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="13,9"/>
        </Style>

        <!-- A 30px circular avatar. Owner uses a restrained MDL2 user glyph;
             GENIE uses the real brand mark. No invented photograph. -->
        <Style x:Key="AvatarShell" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="{StaticResource G.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource G.LineSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource G.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Message surface ============ -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Center" Margin="8" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets"
                    ToolTip="Load older messages" Command="{Binding OlderHistoryCommand}" IsEnabled="{Binding CanLoadOlder}"/>
            <!-- Empty state: subtle and centred, not a blank panel. -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="32"
                        Visibility="{Binding HasMessages,
                                     Converter={StaticResource InverseBoolToVisibility}}">
                <Image Source="/Genie_brand_256.png" Width="72" Height="72"
                       Stretch="Uniform" Opacity="0.55"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"/>
                <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center" FontSize="17"
                           FontWeight="SemiBold" Foreground="{StaticResource G.Text}"
                           Text="Ask GENIE something."/>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="420" Foreground="{StaticResource G.TextMid}"
                           FontSize="13"
                           Text="It will plan, act and report what it did.&#x0a;Replies appear here as they stream in."/>
            </StackPanel>

            <!-- Conversation. Background is explicit so it can never fall back
                 to the default light surface. -->
            <ListBox x:Name="MessagesList" Grid.Row="1"
                     ItemsSource="{Binding Messages}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="20,16,20,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch">
                <!-- A conversation row, not a selectable list item: no selection
                     chrome, no focus rectangle. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,16">
                            <!-- Owner turn: avatar on the right, bubble right aligned. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        Visibility="{Binding IsUser,
                                                     Converter={StaticResource BoolToVisibility}}">
                                <StackPanel MaxWidth="620" HorizontalAlignment="Right">
                                    <TextBlock Text="You" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Margin="0,0,2,4"
                                               Foreground="{StaticResource G.Primary}"/>
                                    <Border Style="{StaticResource BubbleBorder}"
                                            Background="{StaticResource G.Surface2}"
                                            BorderBrush="{StaticResource G.PrimaryDark}"
                                            BorderThickness="1">
                                        <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True"
                                                   ContextMenu="{StaticResource G.EditMenu}"
                                                   IsInactiveSelectionHighlightEnabled="True"
                                                   SelectionBrush="{StaticResource G.Primary}" SelectionOpacity="0.55"
                                                   Background="Transparent" BorderThickness="0" Padding="0"
                                                   Foreground="{StaticResource G.Text}"
                                                   FontSize="14"/>
                                    </Border>
                                </StackPanel>
                                <Border Style="{StaticResource AvatarShell}" Margin="10,0,0,0"
                                        VerticalAlignment="Bottom">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="{StaticResource G.TextMid}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- GENIE turn: avatar on the left, bubble left aligned. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                        Visibility="{Binding IsUser,
                                                     Converter={StaticResource InverseBoolToVisibility}}">
                                <Border Style="{StaticResource AvatarShell}" Margin="0,0,10,0"
                                        VerticalAlignment="Top">
                                    <Image Source="/Genie_brand_256.png" Width="22" Height="22"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel MaxWidth="620">
                                    <TextBlock Text="GENIE" FontSize="11" FontWeight="SemiBold"
                                               Margin="2,0,0,4"
                                               Foreground="{StaticResource G.Cyan}"/>
                                    <Border Style="{StaticResource BubbleBorder}"
                                            Background="{StaticResource G.Surface}"
                                            BorderBrush="{StaticResource G.LineSoft}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True"
                                                       ContextMenu="{StaticResource G.EditMenu}"
                                                       IsInactiveSelectionHighlightEnabled="True"
                                                       SelectionBrush="{StaticResource G.Primary}" SelectionOpacity="0.55"
                                                       Background="Transparent" BorderThickness="0" Padding="0"
                                                       Foreground="{StaticResource G.Text}"
                                                       FontSize="14"/>

                                            <!-- Compact streaming indicator. Not a giant
                                                 placeholder bubble — a small "Thinking…"
                                                 whose dots pulse while deltas arrive. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding IsStreaming,
                                                                     Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Progress}" FontSize="12"
                                                           Foreground="{StaticResource G.TextDim}"/>
                                                <TextBlock FontSize="12"
                                                           Foreground="{StaticResource G.TextDim}">
                                                    <TextBlock.Text>…</TextBlock.Text>
                                                    <TextBlock.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        From="0.25" To="1"
                                                                        Duration="0:0:0.8"
                                                                        AutoReverse="True"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </TextBlock.Triggers>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Failed turn: retry is the way out. -->
                                            <Button Margin="0,10,0,0" Padding="12,5"
                                                    Style="{StaticResource G.ButtonSmall}"
                                                    Content="Retry"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.RetryCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Visibility="{Binding IsError,
                                                                 Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ============ Composer ============ -->
        <Border Grid.Row="1" Padding="20,14,20,14"
                Background="{StaticResource G.BgDeep}"
                BorderBrush="{StaticResource G.LineSoft}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Padding="12,10"
                        Background="{StaticResource G.Surface}"
                        BorderBrush="{StaticResource G.Line}"
                        BorderThickness="1">
                    <!-- PreviewKeyDown (tunnelling) fires BEFORE the TextBox's own
                         Enter handling, so consuming it here stops the stray newline.
                         A bubbling KeyDown handler runs too late: the newline is
                         already inserted. -->
                    <TextBox x:Name="Composer"
                             ContextMenu="{StaticResource G.EditMenu}"
                             IsInactiveSelectionHighlightEnabled="True"
                             SelectionBrush="{StaticResource G.Primary}" SelectionOpacity="0.55"
                             Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             Foreground="{StaticResource G.Text}"
                             BorderThickness="0"
                             FontSize="14"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             CaretBrush="{StaticResource G.Cyan}"
                             PreviewKeyDown="Composer_PreviewKeyDown">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type TextBox}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TextBox}">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Border>

                <!-- Send, or Stop while a turn is in flight. Never both. -->
                <Button Grid.Row="0" Grid.Column="1" Margin="10,0,0,0"
                        Padding="18,10" VerticalAlignment="Bottom"
                        Style="{StaticResource G.ButtonPrimary}"
                        Content="Send"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding CanSend}"
                        Visibility="{Binding Streaming,
                                     Converter={StaticResource InverseBoolToVisibility}}"/>
                <Button Grid.Row="0" Grid.Column="1" Margin="10,0,0,0"
                        Padding="18,10" VerticalAlignment="Bottom"
                        Style="{StaticResource G.Button}"
                        Content="Stop"
                        Command="{Binding StopCommand}"
                        Visibility="{Binding Streaming,
                                     Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Margin="0,8,0,0" FontSize="11"
                           Foreground="{StaticResource G.TextDim}"
                           Text="Enter sends · Shift+Enter adds a line"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
