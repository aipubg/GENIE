<Application x:Class="Genie.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Genie.Desktop.Converters">
    <!-- No StartupUri: startup is owned by App.OnStartup so the single-instance
         check and the backend lifecycle run before any window exists. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette is merged at app level so brush lookups succeed
                     even inside ControlTemplate triggers (which can evaluate
                     before GenieControls's own MergedDictionaries are visible). -->
                <ResourceDictionary Source="Themes/GeniePalette.xaml"/>
                <ResourceDictionary Source="Themes/GenieControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
            <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibility"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:BrushKeyToBrushConverter x:Key="BrushKeyToBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>