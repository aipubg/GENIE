<!--
  DARK variant of the GENIE palette (the original identity).
  Same resource KEYS as the light palette so bindings are theme-agnostic.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="G.Bg"       Color="#FF060912"/>
    <SolidColorBrush x:Key="G.BgDeep"   Color="#FF030611"/>
    <SolidColorBrush x:Key="G.Surface"  Color="#FF0E1726"/>
    <SolidColorBrush x:Key="G.Surface2" Color="#FF142036"/>
    <SolidColorBrush x:Key="G.Line"     Color="#FF22324F"/>
    <SolidColorBrush x:Key="G.LineSoft" Color="#FF1B2742"/>

    <SolidColorBrush x:Key="G.Text"     Color="#FFEDF2FF"/>
    <SolidColorBrush x:Key="G.TextMid"  Color="#FFA9B7D9"/>
    <SolidColorBrush x:Key="G.TextDim"  Color="#FF6E7F9C"/>

    <SolidColorBrush x:Key="G.Primary"  Color="#FF4DA3FF"/>
    <SolidColorBrush x:Key="G.PrimaryDark" Color="#FF2F7BE0"/>
    <SolidColorBrush x:Key="G.Cyan"     Color="#FF55E1FF"/>
    <SolidColorBrush x:Key="G.Violet"   Color="#FF8C7DFF"/>
    <SolidColorBrush x:Key="G.Gold"     Color="#FFE6B86A"/>

    <SolidColorBrush x:Key="G.OK"       Color="#FF6DD58A"/>
    <SolidColorBrush x:Key="G.Warn"     Color="#FFE8B25A"/>
    <SolidColorBrush x:Key="G.Error"    Color="#FFE0707A"/>

    <LinearGradientBrush x:Key="G.Wave" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF55E1FF" Offset="0"/>
        <GradientStop Color="#FF4DA3FF" Offset="0.5"/>
        <GradientStop Color="#FF8C7DFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="G.HeroBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0E1726" Offset="0"/>
        <GradientStop Color="#FF060912" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
